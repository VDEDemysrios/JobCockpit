# ---------------------------------------------------------------
# France Travail — https://francetravail.io
# Créer un compte > Mes applications > nouvelle application
# > s'abonner à l'API « Offres d'emploi v2 » (gratuite)
# ---------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---------------------------------------------------------------
# Adzuna — https://developer.adzuna.com
# Inscription gratuite, 1000 appels/mois
# ---------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------
# Jooble — https://fr.jooble.org/api/about
# Demander une clé API gratuite
# ---------------------------------------------------------------
JOOBLE_API_KEY=

# ---------------------------------------------------------------
# Flux RSS — AUCUNE clé ici.
# Cette source se configure dans profile/profile.json, bloc "flux".
# Elle permet d'ajouter n'importe quel site publiant un flux
# (APEC, Welcome to the Jungle, pages carrière d'employeurs…)
# sans écrire une ligne de code.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# Clé gratuite. Sert à l'analyse des offres et aux lettres.
# ---------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------
# Indeed — RÉSERVÉ, inactif (voir spec §5.4)
# Laisser vide : la source est automatiquement sautée.
# ---------------------------------------------------------------
INDEED_API_KEY=

# Port du serveur (plan 2)
PORT=3000

# ---------------------------------------------------------------
# Spotify — https://developer.spotify.com/dashboard
# Cree une application, puis dans ses reglages ajoute EXACTEMENT
# cette adresse de redirection :
#   http://127.0.0.1:3000/spotify/retour
#
# Seul le Client ID est necessaire : il est PUBLIC par conception.
# Le Client Secret propose par Spotify ne sert pas ici — le flux
# PKCE sen passe, et il ne doit etre colle nulle part.
# ---------------------------------------------------------------
SPOTIFY_CLIENT_ID=

# ---------------------------------------------------------------
# Twitch — https://dev.twitch.tv/console/apps
# Enregistre une application. La connexion se fait par un CODE a
# recopier sur twitch.tv/activate : il n y a AUCUNE URL de
# redirection a faire correspondre.
#
# Le formulaire en exige quand meme une, et refuse tout ce qui ne
# commence pas par https. Mets n importe quoi de valide, par exemple
#   https://localhost/
# Elle ne sera jamais utilisee.
#
# Type de client : PUBLIQUE. « Confidentiel » suppose un secret garde
# cote serveur ; il n y en a pas ici, et le Client Secret que Twitch
# propose de generer ne doit etre colle nulle part.
#
# Sans cette cle, le lecteur Twitch marche quand meme : c est la
# LISTE de tes chaines suivies en direct qui n apparait pas.
# ---------------------------------------------------------------
TWITCH_CLIENT_ID=

# ---------------------------------------------------------------
# YouTube — https://console.cloud.google.com
# UNIQUEMENT pour NAVIGUER (accueil + recherche) dans l onglet
# YouTube du lecteur. Sans cette cle, coller un lien marche tres
# bien : c est la navigation qui a besoin de l API.
#
# Cree un projet, active « YouTube Data API v3 », puis cree une
# CLE D API. Pas d OAuth, pas d ecran de consentement, pas de
# compte a lier.
#
# Quota gratuit : 10 000 unites/jour. L accueil coute 1 unite,
# une recherche 100 — soit une centaine de recherches par jour.
#
# Pourquoi une cle plutot que de lire la page de resultats :
# le projet s interdit le scraping (meme regle que pour Indeed),
# et une page analysee a la main casse au premier changement de
# balisage, sans prevenir.
# ---------------------------------------------------------------
YOUTUBE_API_KEY=
# Pays de l accueil (populaires). FR par defaut.
YOUTUBE_PAYS=FR
